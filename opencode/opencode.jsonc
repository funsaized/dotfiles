{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,
  "model": "openai/gpt-5.6-sol",
  "default_agent": "build",
  "plugin": ["@dietrichgebert/ponytail@4.9.0"],
  "permission": {
    "bash": {
      "git push *": "ask",
      "rm -rf *": "ask"
    },
    "edit": {
      "~/.config/**": "ask"
    },
    "read": {
      "**/.env*": "ask"
    }
  },

  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 20000,
    "reserved": 20000
  },

  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24576
  },

  "watcher": {
    "ignore": [
      "target/**",
      "node_modules/**",
      ".next/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      "**/*.log"
    ]
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"]
    }
  },

  "command": {
    "review": {
      "description": "Cross-vendor review of the current diff",
      "agent": "reviewer",
      "template": "Run git diff (and git diff --staged) to see the current changes. Review them for correctness, security issues, regressions, and missing tests. Report findings in severity order with file:line references before any summary. Do not modify anything."
    },
    "brief": {
      "description": "Digest a file or directory into a structured brief",
      "agent": "digest",
      "template": "Digest $ARGUMENTS into a structured brief: purpose, key components, notable patterns, risks."
    },
    "handoff": {
      "description": "Summarize session state for the offshore team",
      "template": "Summarize what was changed this session, why, open questions, and suggested next steps, written for a developer picking this up cold."
    }
  },

  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "variant": "low"
    },
    "plan": {
      "model": "xai/grok-4.6",
      "variant": "xhigh"
    },
    "explore": {
      "model": "minimax-coding-plan/MiniMax-M3"
    },
    "general": {
      "model": "minimax-coding-plan/MiniMax-M3"
    },
    "operator": {
      "description": "General-purpose coding agent powered by MiniMax M3",
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M3"
    },
    "frontend": {
      "description": "Frontend and visual work: React/Next.js components, styling, layout, animation, interactive polish",
      "mode": "all",
      "model": "xai/grok-4.6",
      "variant": "high",
      "color": "#e17055",
      "prompt": "You specialize in frontend implementation: React/Next.js components, styling, layout, animation, and interactive polish. Favor working, visually complete first passes. Match the project's existing component patterns and design tokens before introducing new ones."
    },
    "reviewer": {
      "description": "Reviews changes for correctness, security, regressions, and missing tests without modifying anything",
      "mode": "subagent",
      "model": "xai/grok-4.6",
      "variant": "xhigh",
      "color": "#6c5ce7",
      "steps": 10,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        }
      }
    },
    "digest": {
      "description": "Summarizes large documents, logs, or unfamiliar codebases into structured briefs",
      "mode": "subagent",
      "model": "minimax-coding-plan/MiniMax-M3",
      "color": "#00b894",
      "prompt": "Digest the provided material into a structured brief: purpose, key components, notable patterns, risks or open questions. Be concrete and cite file paths or sections. Do not speculate beyond the material."
    },
    "grunt": {
      "description": "Mechanical, low-judgment edits: renames, boilerplate, test scaffolding, repetitive migrations, applying an already-specified pattern across files",
      "mode": "subagent",
      "model": "ollama/qwen3.5:9b",
      "color": "#fdcb6e",
      "steps": 25,
      "prompt": "You perform mechanical, fully specified code changes. Do not explore broadly, design, reinterpret requirements, or refactor beyond the instruction. A valid task names the exact files or scope, the transformation, an exemplar when pattern matching is required, forbidden scope, acceptance criteria, and a verification command. If essential information is missing or ambiguous, stop and report the missing detail. Otherwise, read the specified files, apply the smallest consistent diff, avoid unrelated files, run the requested verification, and report changed files plus the verification result. Never delegate to another agent.",
      "permission": {
        "task": "deny",
        "bash": {
          "git *": "ask"
        }
      }
    }
  },

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "apiKey": "ollama",
        "baseURL": "http://127.0.0.1:11434/v1",
        "includeUsage": true
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B",
          "options": {
            "reasoningEffort": "none"
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.6": {
          "variants": {
            "high": { "reasoningEffort": "high" },
            "xhigh": { "reasoningEffort": "xhigh" }
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" }
          }
        }
      }
    }
  }
}
