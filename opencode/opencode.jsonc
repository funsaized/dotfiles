{
  // Published schema at opencode.ai/config.json is still V1 and flags the
  // plural V2 fields — omit $schema or ignore editor warnings; opencode2 is fine.

  // Root default — provider/model only; V2 does not retain a #variant here
  "autoupdate": false,
  "model": "openai/gpt-5.6-sol",
  "default_agent": "build",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "edit", "resource": "~/.config/**", "effect": "ask" },
    { "action": "read", "resource": "**/.env*", "effect": "ask" }
  ],
  // Avoid inheriting defaults
  "compaction": { "auto": true, "keep": { "tokens": 20000 }, "buffer": 20000 },

  // Optimizations b/c $$$
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 24576
  },


  // Ignore build files
  "watcher": {
    "ignore": [
      "target/**",          // Rust — the big one for herdr-terminal
      "node_modules/**",
      ".next/**",           // Next.js build output
      "dist/**",
      "build/**",
      "coverage/**",
      ".turbo/**",
      "**/*.log"
    ]
  },

  // MCPs leveraged often
  "mcp": {
    "servers": {
      "playwright": { "type": "local", "command": ["bunx", "@playwright/mcp"] }
    }
  },

  "commands": {
    "review": {
      "description": "Cross-vendor review of the current diff",
      "agent": "reviewer",
      "template": "Run git diff (and git diff --staged) to see the current changes. Review them for correctness, security issues, regressions, and missing tests. Report findings in severity order with file:line references before any summary. Do not modify anything."
    },
    "brief": {
      "description": "Digest a file or directory into a structured brief",
      "agent": "digest",
      "template": "Digest $ARGUMENTS into a structured brief: purpose, key components, notable patterns, risks."
    },
    "handoff": {
      "description": "Summarize session state for the offshore team",
      "template": "Summarize what was changed this session, why, open questions, and suggested next steps, written for a developer picking this up cold."
    }
  },

  "agents": {
    // ── Primary agents ─────────────────────────────────────────────

    // Implementation — Sol at low effort; cycle up via variant_cycle when
    // a task turns out to be gnarlier than expected
    "build": {
      "model": "openai/gpt-5.6-sol#low"
    },

    // Planning — Grok 4.6 xhigh: 500K context for whole-repo passes,
    // low-frequency turns so it won't drain the SuperGrok weekly pool
    "plan": {
      "model": "xai/grok-4.6#xhigh"
    },

    // ── Built-in subagents → MiniMax Token Plan ────────────────────

    "explore": {
      "model": "minimax/MiniMax-M3"
    },

    "general": {
      "model": "minimax/MiniMax-M3"
    },

    // ── Custom specialists ─────────────────────────────────────────

    "frontend": {
      "description": "Frontend and visual work: React/Next.js components, styling, layout, animation, interactive polish",
      "mode": "all",
      "model": "xai/grok-4.6#high",
      "color": "#e17055",
      "system": "You specialize in frontend implementation: React/Next.js components, styling, layout, animation, and interactive polish. Favor working, visually complete first passes. Match the project's existing component patterns and design tokens before introducing new ones."
    },

    "reviewer": {
      "description": "Reviews changes for correctness, security, regressions, and missing tests without modifying anything",
      "mode": "subagent",
      "model": "xai/grok-4.6#xhigh",
      "color": "#6c5ce7",
      "steps": 10,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" }
      ]
    },

    "digest": {
      "description": "Summarizes large documents, logs, or unfamiliar codebases into structured briefs",
      "mode": "subagent",
      "model": "minimax/MiniMax-M3",
      "color": "#00b894",
      "system": "Digest the provided material into a structured brief: purpose, key components, notable patterns, risks or open questions. Be concrete and cite file paths or sections. Do not speculate beyond the material."
    },

    "grunt": {
      "description": "Mechanical, low-judgment edits: renames, boilerplate, test scaffolding, repetitive migrations, applying an already-specified pattern across files",
      "mode": "subagent",
      "model": "minimax/MiniMax-M3",
      "color": "#fdcb6e",
      "steps": 25,
      "system": "You execute mechanical, well-specified edits exactly as instructed: renames, boilerplate, scaffolding, and repetitive pattern application. Do not redesign, refactor beyond the instruction, or make judgment calls — if the instruction is ambiguous, stop and report the ambiguity instead of guessing.",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git *", "effect": "ask" }
      ]
    }
  },

  // Pin Sol's effort ladder explicitly so variant_cycle has the full range
  // even if the catalog metadata is incomplete for the ChatGPT-login path
  "providers": {
    "xai": {
      "models": {
        "grok-4.6": {
          "variants": [
            { "id": "high",  "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } }
          ]
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "variants": [
            { "id": "low",    "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high",   "settings": { "reasoningEffort": "high" } }
          ]
        }
      }
    }
  }
}
